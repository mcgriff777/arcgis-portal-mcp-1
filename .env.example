# ArcGIS Portal MCP - Environment Configuration
# Copy this file to .env and fill in your credentials.
#
# .env search order:
#   1. Package directory (next to this file)
#   2. Current working directory (where you launch the server)
#   3. ~/.arcgis-portal-mcp/.env (for pip installs)
#
# Existing OS environment variables take precedence over .env values.
# Quoted values are supported: password="my secret"

# Portal URL (required)
portal_url=https://your-portal.example.com/portal

# Option 1: Username + password (user-level token, full permissions)
username=your_username
password=your_password

# Option 2: OAuth2 client credentials (app-level token, limited permissions)
# oauth_client_id=your_client_id
# oauth_client_secret=your_client_secret

# --- Security Options ---

# TLS verification (default: true)
# Set to false only for Enterprise portals with self-signed certificates.
# When true, certificate verification is enforced and InsecureRequestWarning is shown.
# MCP_TLS_VERIFY=true

# Scoped allowlists (optional, all default to unrestricted)
# When set, the server will only operate within these boundaries.
# Comma-separated lists. Leave commented out for no restrictions.

# MCP_ALLOWED_PORTAL_URLS=https://gis.example.com/portal,https://gis2.example.com/portal
# MCP_ALLOWED_OWNERS=jsmith,mgarcia,admin
# MCP_ALLOWED_GROUPS=abc123,def456
# MCP_ALLOWED_SERVICE_URLS=https://gis.example.com/portal/sharing/rest/services,https://services.arcgis.com
